# Upstream checkout, Mihawk's driver checkouts and everything built from them
/src-upstream/
/radv/
/build*/
/.deps/
/dist/
# ROMs and anything derived from them
*.n64
*.z64
*.v64
# Local downloads, not part of the port
/downloads/
# Local tool state and logs (build logs too)
/.home/
/logs/
*.log
