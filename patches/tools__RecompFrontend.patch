+// PS5: the list's order is changed with the controller, as there's no pointer to drag entries with. The apply
+// button (Triangle) picks the focused entry up; up and down then move it a place at a time, each move made
+// and saved as a drag's is (set_mod_index); the apply button again, Cross or the back button puts it down.
+// Left and right do nothing meanwhile, so the focus stays on it. A pack higher in the list wins where two
+// replace the same texture (rt64_render_context.cpp), which is what the order is for.
+bool ModMenu::mod_key_pressed(uint32_t mod_index, int rml_key) {
+    if (rml_key == mod_entry_focus_lost) {
+        // Left by other means (another tab, the menu closed): put it down.
+        if (moving_mod_index == static_cast<int32_t>(mod_index)) {
+            set_moving_mod(-1);
+        }
+        return false;
+    }
+
+    const MenuAction action = menu_action_mapping::menu_action_from_rml_key(static_cast<Rml::Input::KeyIdentifier>(rml_key));
+    if (moving_mod_index < 0) {
+        if (action == MenuAction::Apply && mod_index < mod_entry_buttons.size()) {
+            set_moving_mod(static_cast<int32_t>(mod_index));
+            return true;
+        }
+        return false;
+    }
+
+    switch (rml_key) {
+    case Rml::Input::KI_UP:
+        if (moving_mod_index > 0) {
+            move_mod(moving_mod_index, moving_mod_index - 1);
+        }
+        return true;
+    case Rml::Input::KI_DOWN:
+        if (static_cast<size_t>(moving_mod_index) + 1 < mod_entry_buttons.size()) {
+            move_mod(moving_mod_index, moving_mod_index + 1);
+        }
+        return true;
+    case Rml::Input::KI_LEFT:
+    case Rml::Input::KI_RIGHT:
+        return true;
+    default:
+        break;
+    }
+
+    if (action == MenuAction::Apply || action == MenuAction::Accept || action == MenuAction::Back) {
+        set_moving_mod(-1);
+        return true;
+    }
+
+    // Another tab, or the menu closing: put it down, and let the action happen.
+    if (action != MenuAction::None) {
+        set_moving_mod(-1);
+    }
+    return false;
+}
+
+void ModMenu::move_mod(uint32_t from_index, uint32_t to_index) {
+    // As at the end of a drag: re-order the mods and update all the entries.
+    recomp::mods::set_mod_index(game_mod_id, mod_details[from_index].mod_id, to_index);
+    mod_details = recomp::mods::get_all_mod_details(game_mod_id);
+    for (size_t i = 0; i < mod_entry_buttons.size(); i++) {
+        mod_entry_buttons[i]->set_mod_details(mod_details[i]);
+        mod_entry_buttons[i]->set_mod_thumbnail(generate_thumbnail_src_for_mod(mod_details[i].mod_id));
+        mod_entry_buttons[i]->set_mod_enabled(is_mod_enabled_or_auto(mod_details[i].mod_id));
+    }
+
+    // The picked-up entry is now the one at to_index: the highlight and the focus follow it. The entry it
+    // left loses the focus after this, and isn't the picked-up one any more (mod_key_pressed).
+    mod_entry_buttons[from_index]->set_moving(false);
+    moving_mod_index = static_cast<int32_t>(to_index);
+    mod_entry_buttons[to_index]->set_moving(true);
+    mod_selected(to_index);
+    mod_entry_buttons[to_index]->focus();
+}
+
+void ModMenu::set_moving_mod(int32_t mod_index) {
+    if (moving_mod_index >= 0 && static_cast<size_t>(moving_mod_index) < mod_entry_buttons.size()) {
+        mod_entry_buttons[moving_mod_index]->set_moving(false);
+    }
+    moving_mod_index = mod_index;
+    if (moving_mod_index >= 0) {
+        mod_entry_buttons[moving_mod_index]->set_moving(true);
+    }
+    render_order_notice();
+}
+
+void ModMenu::render_order_notice() {
+    if (order_notice_idle == nullptr || order_notice_moving == nullptr) {
+        return;
+    }
+    order_notice_idle->set_display(moving_mod_index < 0 ? Display::Flex : Display::None);
+    order_notice_moving->set_display(moving_mod_index < 0 ? Display::None : Display::Flex);
+}
