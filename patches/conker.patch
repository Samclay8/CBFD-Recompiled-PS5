+            PS5_KERNEL_MAP_FIXED, direct, PS5_KERNEL_DIRECT_ALIGNMENT);
+        ok = res == 0 && mapped == begin;
+        if (!ok) {
+            sceKernelReleaseDirectMemory(direct, length);
+        }
+    }
+    std::fprintf(stderr, "[overlays] 0x%08X (+0x%zX): %zu KiB of direct memory at %p %s (0x%08X)\n", vram, size,
+        length / 1024, (void*)begin, ok ? "mapped" : "not mapped", (unsigned)res);
